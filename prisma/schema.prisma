generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  ADMIN
  PRESIDENT
  DELEGUE_GENERAL
  TRESORIER
  MEMBRE_BUREAU
  MEMBRE_CA
  ADHERENT
}

enum AdherentType {
  DIRECT
  FEDERATION
  SYNDICAT
}

enum Secteur {
  COMMERCE
  INDUSTRIE
  SERVICES
  BTP
}

enum CotisationStatus {
  PENDING
  PAID
  OVERDUE
  SUSPENDED
}

enum MandatClassification {
  STRATEGIQUE
  TECHNIQUE
}

enum MandatAssignmentStatus {
  ACTIVE
  TERMINE
  SUSPENDU
}

enum CandidatureStatus {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

enum TicketCategory {
  JURIDIQUE
  PRESSE
  COTISATION
  AUTRE
}

enum TicketStatus {
  OUVERT
  EN_COURS
  RESOLU
  FERME
}

enum PresenceType {
  PRESENTIEL
  VISIO
}

enum VoteSessionStatus {
  EN_COURS
  TERMINEE
  ANNULEE
}

enum MatchingFundStatus {
  EN_ATTENTE
  VALIDE
  REFUSE
}

enum FormationStatus {
  DISPONIBLE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum AppelOffreStatus {
  OUVERT
  FERME
  ATTRIBUE
}

enum SuiviFormationStatus {
  INSCRIT
  EN_COURS
  TERMINE
  ABANDONNE
}

// =============================================================================
// AUTH & USER
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          Role      @default(ADHERENT)
  isActive      Boolean   @default(true)
  gdprConsent   Boolean   @default(false)
  gdprConsentAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  adherent              Adherent?
  accounts              Account[]
  sessions              Session[]
  auditLogs             AuditLog[]
  convocationsCreated   Convocation[]
  emargements           Emargement[]
  engagementDeclaration EngagementDeclaration?
  ticketsCreated        Ticket[]                @relation("TicketCreator")
  ticketsAssigned       Ticket[]                @relation("TicketAssignee")
  ticketMessages        TicketMessage[]
  matchingValidations   MatchingFundAbondement[] @relation("MatchingValidator")

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================================================================
// MODULE 1 : CRM ADHÉRENTS & COTISATIONS
// =============================================================================

model Adherent {
  id          String       @id @default(cuid())
  userId      String       @unique
  type        AdherentType @default(DIRECT)
  siret       String?      @unique
  companyName String
  secteur     Secteur
  effectif    Int
  caAnnuel    Float?
  isVIP       Boolean      @default(false)
  memberSince DateTime     @default(now())
  isActive    Boolean      @default(true)
  notes       String?      @db.Text
  phone       String?
  address     String?
  city        String?
  postalCode  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cotisations         Cotisation[]
  mandatAssignments   MandatAssignment[]
  mandatCandidatures  MandatCandidature[]
  mandatReports       MandatReport[]
  tickets             Ticket[]
  appelOffreResponses AppelOffreResponse[]
  suiviFormations     SuiviFormation[]

  @@index([secteur])
  @@index([type])
  @@index([isVIP])
  @@index([isActive])
}

model Cotisation {
  id         String           @id @default(cuid())
  adherentId String
  year       Int
  amount     Float
  status     CotisationStatus @default(PENDING)
  dueDate    DateTime
  paidAt     DateTime?
  invoiceRef String?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  adherent Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  @@unique([adherentId, year])
  @@index([status])
  @@index([year])
  @@index([dueDate])
}

model CotisationBareme {
  id          String   @id @default(cuid())
  label       String
  effectifMin Int
  effectifMax Int
  amount      Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// =============================================================================
// MODULE 2 : GOUVERNANCE & DÉMOCRATIE
// =============================================================================

model Instance {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  convocations Convocation[]
  voteSessions VoteSession[]
}

model Convocation {
  id          String    @id @default(cuid())
  instanceId  String
  createdById String
  date        DateTime
  subject     String
  description String?   @db.Text
  location    String?
  isOnline    Boolean   @default(false)
  onlineLink  String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  instance     Instance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdBy    User          @relation(fields: [createdById], references: [id])
  emargements  Emargement[]
  voteSessions VoteSession[]

  @@index([instanceId])
  @@index([date])
}

model Emargement {
  id            String       @id @default(cuid())
  convocationId String
  userId        String
  presenceType  PresenceType
  signedAt      DateTime     @default(now())

  convocation Convocation @relation(fields: [convocationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([convocationId, userId])
}

model VoteSession {
  id            String            @id @default(cuid())
  instanceId    String
  convocationId String?
  subject       String
  description   String?           @db.Text
  options       Json
  isAnonymous   Boolean           @default(true)
  status        VoteSessionStatus @default(EN_COURS)
  closedAt      DateTime?
  createdAt     DateTime          @default(now())

  instance    Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  convocation Convocation? @relation(fields: [convocationId], references: [id])
  votes       Vote[]

  @@index([instanceId])
  @@index([status])
}

model Vote {
  id            String   @id @default(cuid())
  voteSessionId String
  encryptedVote String
  voterHash     String
  createdAt     DateTime @default(now())

  voteSession VoteSession @relation(fields: [voteSessionId], references: [id], onDelete: Cascade)

  @@index([voteSessionId])
}

model EngagementDeclaration {
  id          String   @id @default(cuid())
  userId      String   @unique
  tempsAlloue Float
  axesPactes  Json
  commentaire String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================================================================
// MODULE 3 : MANDATS
// =============================================================================

model Mandat {
  id             String               @id @default(cuid())
  name           String
  organisme      String
  classification MandatClassification
  description    String?              @db.Text
  feuilleDeRoute String?              @db.Text
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  assignments  MandatAssignment[]
  candidatures MandatCandidature[]

  @@index([organisme])
  @@index([classification])
  @@index([isActive])
}

model MandatAssignment {
  id         String                 @id @default(cuid())
  mandatId   String
  adherentId String
  startDate  DateTime
  endDate    DateTime?
  status     MandatAssignmentStatus @default(ACTIVE)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  mandat   Mandat         @relation(fields: [mandatId], references: [id], onDelete: Cascade)
  adherent Adherent       @relation(fields: [adherentId], references: [id], onDelete: Cascade)
  reports  MandatReport[]

  @@index([mandatId])
  @@index([adherentId])
  @@index([status])
}

model MandatCandidature {
  id         String            @id @default(cuid())
  mandatId   String
  adherentId String
  motivation String?           @db.Text
  status     CandidatureStatus @default(EN_ATTENTE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  mandat   Mandat   @relation(fields: [mandatId], references: [id], onDelete: Cascade)
  adherent Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  @@unique([mandatId, adherentId])
}

model MandatReport {
  id                 String   @id @default(cuid())
  mandatAssignmentId String
  adherentId         String
  decisionsClefs     String   @db.Text
  pointsAlerte       String?  @db.Text
  voteEmis           String?
  attachments        Json?
  createdAt          DateTime @default(now())

  mandatAssignment MandatAssignment @relation(fields: [mandatAssignmentId], references: [id], onDelete: Cascade)
  adherent         Adherent         @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  @@index([mandatAssignmentId])
  @@index([createdAt])
}

// =============================================================================
// MODULE 4 : INNOVATIONS (MATCHING FUND & FORMATIONS)
// =============================================================================

model MatchingFundDon {
  id         String   @id @default(cuid())
  meceneName String
  amount     Float
  date       DateTime
  reference  String?
  createdAt  DateTime @default(now())

  abondements MatchingFundAbondement[]
}

model MatchingFundAbondement {
  id                String             @id @default(cuid())
  donId             String
  actionDescription String
  amount            Float
  animateurName     String
  validatedById     String?
  status            MatchingFundStatus @default(EN_ATTENTE)
  validatedAt       DateTime?
  createdAt         DateTime           @default(now())

  don         MatchingFundDon @relation(fields: [donId], references: [id], onDelete: Cascade)
  validatedBy User?           @relation("MatchingValidator", fields: [validatedById], references: [id])

  @@index([status])
}

model Formation {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  category    String
  duration    String?
  status      FormationStatus @default(DISPONIBLE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  appelsOffre     AppelOffre[]
  suiviFormations SuiviFormation[]
}

model AppelOffre {
  id          String           @id @default(cuid())
  formationId String
  description String           @db.Text
  deadline    DateTime
  status      AppelOffreStatus @default(OUVERT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  formation Formation            @relation(fields: [formationId], references: [id], onDelete: Cascade)
  responses AppelOffreResponse[]

  @@index([status])
  @@index([deadline])
}

model AppelOffreResponse {
  id           String   @id @default(cuid())
  appelOffreId String
  adherentId   String
  proposal     String   @db.Text
  amount       Float?
  createdAt    DateTime @default(now())

  appelOffre AppelOffre @relation(fields: [appelOffreId], references: [id], onDelete: Cascade)
  adherent   Adherent   @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  @@unique([appelOffreId, adherentId])
}

model SuiviFormation {
  id          String               @id @default(cuid())
  formationId String
  adherentId  String
  status      SuiviFormationStatus @default(INSCRIT)
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  formation Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  adherent  Adherent  @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  @@unique([formationId, adherentId])
}

// =============================================================================
// MODULE 5 : COMMUNICATION (TICKETING)
// =============================================================================

model Ticket {
  id           String         @id @default(cuid())
  adherentId   String?
  createdById  String
  assignedToId String?
  category     TicketCategory
  subject      String
  status       TicketStatus   @default(OUVERT)
  priority     Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  adherent   Adherent?       @relation(fields: [adherentId], references: [id])
  createdBy  User            @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  messages   TicketMessage[]

  @@index([category])
  @@index([status])
  @@index([adherentId])
  @@index([assignedToId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// =============================================================================
// AUDIT
// =============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
