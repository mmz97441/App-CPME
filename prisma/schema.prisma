generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ENTREPRENEUR
  ADMIN
  ANALYSTE
  MODERATEUR
  INSTITUTION
  DATA_VIEW_ONLY
}

enum SignalementLevel {
  LOCAL
  NATIONAL
  EU
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  passwordHash   String
  role           Role      @default(ENTREPRENEUR)
  gdprConsent    Boolean   @default(false)
  gdprConsentAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company            Company?
  diagnostics        Diagnostic[]
  signalements       Signalement[]
  healthAssessments  HealthAssessment[]
  votes              Vote[]
  auditLogs          AuditLog[]
  accounts           Account[]
  sessions           Session[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String
  sector        String
  effectif      Int
  caAnnuel      Float
  statutJuridique String
  region        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnostics Diagnostic[]

  @@index([sector])
  @@index([region])
  @@index([effectif])
}

model Diagnostic {
  id              String   @id @default(cuid())
  userId          String
  companyId       String
  rawAnswers      Json
  complexityScore Float
  fiscalScore     Float
  socialScore     Float
  adminScore      Float
  createdAt       DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
}

model Signalement {
  id                String           @id @default(cuid())
  userId            String
  title             String
  description       String           @db.Text
  estimatedTimeLoss Float
  estimatedCost     Float
  level             SignalementLevel
  sector            String
  severityScore     Float            @default(0)
  votesCount        Int              @default(0)
  aiCategory        String?
  aiSummary         String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([userId])
  @@index([sector])
  @@index([level])
  @@index([severityScore])
  @@index([createdAt])
}

model Vote {
  id            String   @id @default(cuid())
  userId        String
  signalementId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalement Signalement @relation(fields: [signalementId], references: [id], onDelete: Cascade)

  @@unique([userId, signalementId])
}

model HealthAssessment {
  id                    String   @id @default(cuid())
  userId                String
  fatigueMentale        Int
  chargeEmotionnelle    Int
  isolement             Int
  difficulteDecisionnelle Int
  score                 Float
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
